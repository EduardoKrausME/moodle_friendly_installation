<!doctype html>
<html lang="{{html_lang}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{page_title}}</title>
    <link rel="stylesheet" href="/assets/style.css">
</head>
<body class="{{body_class}}">
<svg class="icon-sprite" aria-hidden="true">
