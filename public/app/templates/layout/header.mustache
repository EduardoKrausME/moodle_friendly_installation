    <symbol id="icon-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></symbol>
</svg>
{{#has_user}}
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="{{i18n.navigation.home_aria}}">
            <span class="brand-mark"><svg><use href="#icon-layers"></use></svg></span>
            <span class="brand-copy">
                <strong>{{app_name}}</strong>
                <small>{{i18n.navigation.control_center}}</small>
            </span>
        </a>

        <nav class="side-nav" aria-label="{{i18n.navigation.main_menu}}">
            {{#navigation}}
                <a class="{{class}}" href="{{url}}">
                    <svg class="nav-icon" aria-hidden="true"><use href="#icon-{{icon}}"></use></svg>
                    <span>{{label}}</span>
                </a>
            {{/navigation}}
        </nav>

        <div class="sidebar-footer">
            <a class="connected-user-link" href="/profile.php" title="{{i18n.profile.edit_title}}">
                <span class="user-avatar"><svg aria-hidden="true"><use href="#icon-users"></use></svg></span>
                <span class="user-copy">
                    <strong>{{user_name}}</strong>
                    <small>{{i18n.navigation.connected_user}}</small>
                </span>
            </a>

            <div class="language-selector sidebar-language-selector" aria-label="{{language.change}}">
                <small>{{language.label}}</small>
                <div class="language-options language-options-loged">
                    {{#language.items}}
                        <a class="{{class}}" href="{{url}}" aria-current="{{aria_current}}" title="{{name}}">
                            <img src="{{flag}}" alt="{{native_name}}" loading="lazy">
                            <span>{{native_name}}</span>
                        </a>
                    {{/language.items}}
                </div>
            </div>
            <a class="sidebar-logout" href="/logout.php">
                <svg aria-hidden="true"><use href="#icon-logout"></use></svg>
                <span>{{i18n.navigation.logout}}</span>
            </a>
        </div>
    </aside>

    <main class="main-content">
{{/has_user}}
{{^has_user}}
<main class="auth-container">
{{/has_user}}
