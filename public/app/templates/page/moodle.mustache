<section class="page-title management-title">
    <div>
        <h1>{{{i18n.moodle.heading}}}</h1>
        <p>{{{i18n.moodle.intro}}}</p>
    </div>
    <div class="title-actions">
        <a class="button" href="/install.php">{{{i18n.actions.install_moodle}}}</a>
        <form action="/phpmyadmin-signon.php" method="post" target="_blank">
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <button class="button secondary" type="submit">{{{i18n.dashboard.open_phpmyadmin}}}</button>
        </form>
    </div>
</section>

{{#has_flash}}
    <div class="alert ok">{{flash}}</div>
{{/has_flash}}

{{^has_sites}}
    <div class="card empty-state">
        <div class="empty-icon">+</div>
        <h2>{{{i18n.moodle.empty_heading}}}</h2>
        <p>{{{i18n.moodle.empty_intro}}}</p>
        <a class="button" href="/install.php">{{{i18n.actions.install_first_moodle}}}</a>
    </div>
{{/has_sites}}

{{#has_sites}}
    <div class="management-toolbar">
        <label class="search-field">
            <span>{{{i18n.actions.search}}}</span>
            <input
                type="search"
                id="moodle-site-filter"
                placeholder="{{{i18n.actions.search}}}"
                autocomplete="off"
                aria-controls="moodle-site-grid">
        </label>
    </div>

    <section class="site-grid" id="moodle-site-grid">
        {{#sites}}
            <article class="site-card" data-search="{{domain}} {{site_fullname}} {{site_shortname}}">
                <div class="site-card-header">
                    <div>
                        {{#has_site_identity}}
                            {{#site_shortname}}
                                <span class="eyebrow"
                                      style="word-break: break-all;">{{site_fullname}}</span>
                            {{/site_shortname}}
                            <h2>{{site_shortname}}</h2>
                        {{/has_site_identity}}
                        {{^has_site_identity}}
                            <h2>{{domain}}</h2>
                        {{/has_site_identity}}
                    </div>
                    {{{status_badge}}}
                </div>
                <a class="button secondary" href="{{details_url}}">{{details_label}}</a>
            </article>
        {{/sites}}
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filter = document.getElementById("moodle-site-filter");
            const grid = document.getElementById("moodle-site-grid");
            if (!filter || !grid) return;

            const cards = Array.from(grid.querySelectorAll(".site-card"));
            const normalize = function (value) {
                return value
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase();
            };
            const searchableCards = cards.map(function (card) {
                return {
                    card: card,
                    search: normalize(card.textContent + " " + card.dataset.search),
                };
            });

            filter.addEventListener("input", function () {
                const query = normalize(filter.value.trim());
                searchableCards.forEach(function (entry) {
                    entry.card.hidden = query !== "" && !entry.search.includes(query);
                });
            });
        });
    </script>
{{/has_sites}}
