<section class="page-title">
    <div>
        <h1>{{{i18n.moodle_plugins.heading}}}</h1>
        <p>{{domain}}</p>
    </div>
    <div class="hero-actions">
        <a class="button secondary" href="{{details_url}}">{{{i18n.moodle_plugins.back_to_details}}}</a>
        <a class="button secondary" href="/moodle_plugins.php?domain={{domain}}">{{{i18n.moodle_plugins.check_again}}}</a>
    </div>
</section>

{{#has_flash}}
    <div class="alert {{flash_class}}">{{flash}}</div>
{{/has_flash}}

{{#show_finish_install}}
    <div class="card hero-card">
        <div>
            <h2>{{{i18n.moodle_plugins.finish_heading}}}</h2>
            <p>{{{i18n.moodle_plugins.finish_intro_before}}} <strong>{{installed_component}}</strong> {{{i18n.moodle_plugins.finish_intro_after}}}</p>
        </div>
        <div class="hero-actions">
            <a class="button" href="{{admin_url}}" target="_blank" rel="noopener">{{{i18n.moodle_plugins.open_site_admin}}}</a>
        </div>
    </div>
{{/show_finish_install}}

{{#has_updates}}
    <div class="alert warning">
        {{{i18n.moodle_plugins.updates_available_before}}} <strong>{{update_count}}</strong> {{{i18n.moodle_plugins.updates_available_after}}}
    </div>
{{/has_updates}}

<div class="details-grid">
    <div class="card full-card">
        <div class="section-heading-actions">
            <div>
                <h2>{{{i18n.moodle_plugins.installed_heading}}}</h2>
                <p class="card-subtitle">{{{i18n.moodle_plugins.installed_intro}}}</p>
            </div>
        </div>

        {{^has_plugins}}
            <div class="alert warning compact-alert">{{{i18n.moodle_plugins.empty}}}</div>
        {{/has_plugins}}

        {{#has_plugins}}
            <div style="overflow-x:auto;">
                <table class="details-table" style="width:100%;">
                    <thead>
                    <tr>
                        <th>{{{i18n.moodle_plugins.column_plugin}}}</th>
                        <th>{{{i18n.moodle_plugins.column_local_version}}}<br>{{{i18n.moodle_plugins.column_remote_version}}}</th>
                        <th>{{{i18n.moodle_plugins.column_status}}}</th>
                        <th>{{{i18n.moodle_plugins.column_action}}}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#plugins}}
                        <tr class="plugin-summary-row" data-details-id="{{row_id}}" tabindex="0"
                            aria-controls="{{row_id}}" aria-expanded="false" style="cursor:pointer;">
                            <td><strong>{{component}}</strong><br><small><code>{{relative_path}}</code></small></td>
                            <td><code>{{local_version}}</code><br><code>{{remote_version_display}}</code></td>
                            <td>{{{status_badge_html}}}</td>
                            <td>
                                <form method="post" class="inline-form plugin-update-form">
                                    <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                                    <input type="hidden" name="action" value="update_plugin">
                                    <input type="hidden" name="component" value="{{component}}">
                                    <button type="submit" class="button" {{^can_update}}disabled{{/can_update}}>{{update_button_label}}</button>
                                </form>
                            </td>
                        </tr>
                        <tr id="{{row_id}}" class="plugin-details-row" hidden>
                            <td colspan="4">
                                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;padding:12px 0;">
                                    <div class="server-control-item">
                                        <div class="flag-header"><strong>{{{i18n.moodle_plugins.local_details}}}</strong></div>
                                        <p><strong>{{{i18n.moodle_plugins.version}}}</strong><br><code>{{local_version}}</code></p>
                                        <p><strong>{{{i18n.moodle_plugins.release}}}</strong><br>{{local_release}}</p>
                                        <p><strong>{{{i18n.moodle_plugins.commit}}}</strong><br><code>{{local_commit}}</code></p>
                                        <p><strong>{{{i18n.moodle_plugins.path}}}</strong><br><code>{{path}}</code></p>
                                    </div>
                                    <div class="server-control-item">
                                        <div class="flag-header"><strong>{{{i18n.moodle_plugins.remote_details}}}</strong></div>
                                        <p><strong>{{{i18n.moodle_plugins.version}}}</strong><br><code>{{remote_version_display}}</code></p>
                                        <p><strong>{{{i18n.moodle_plugins.release}}}</strong><br>{{remote_release_display}}</p>
                                        <p><strong>{{{i18n.moodle_plugins.commit}}}</strong><br><code>{{remote_commit}}</code></p>
                                        <p><strong>{{{i18n.moodle_plugins.branch}}}</strong><br><code>{{branch}}</code></p>
                                        <p><strong>{{{i18n.moodle_plugins.origin}}}</strong><br><code>{{remote}}</code></p>
                                    </div>
                                </div>
                                {{#has_check_error}}
                                    <div class="alert warning compact-alert">{{check_error}}</div>
                                {{/has_check_error}}
                            </td>
                        </tr>
                    {{/plugins}}
                    </tbody>
                </table>
            </div>
        {{/has_plugins}}
    </div>

    <div class="card full-card marketplace-card">
        <div class="section-heading-actions marketplace-heading">
            <div>
                <h2>{{{i18n.moodle_plugins.marketplace_heading}}}</h2>
                <p class="card-subtitle">{{{i18n.moodle_plugins.marketplace_intro}}}</p>
            </div>
            {{#has_marketplace}}
                <div class="marketplace-result-count">
                    <strong id="marketplace-visible-count">{{marketplace_count}}</strong>
                    <span>{{{i18n.moodle_plugins.marketplace_count_suffix}}}</span>
                </div>
            {{/has_marketplace}}
        </div>

        {{#has_marketplace_error}}
            <div class="alert warning compact-alert">{{marketplace_error}}</div>
        {{/has_marketplace_error}}

        {{#has_marketplace}}
            <label class="marketplace-search">
                <span>{{{i18n.moodle_plugins.marketplace_search_label}}}</span>
                <input type="search" id="marketplace-search"
                       placeholder="{{{i18n.moodle_plugins.marketplace_search_placeholder}}}"
                       autocomplete="off">
            </label>

            <div class="marketplace-type-filters" role="group"
                 aria-label="{{{i18n.moodle_plugins.marketplace_type_filters_label}}}">
                {{#marketplace_type_filters}}
                    <button type="button"
                            class="marketplace-type-button {{#is_active}}is-active{{/is_active}}"
                            data-marketplace-type="{{type}}"
                            aria-pressed="{{aria_pressed}}"
                            title="{{label}}">
                        <svg aria-hidden="true"><use href="#{{icon}}"></use></svg>
                        <span>{{label}}</span>
                        <small>{{count}}</small>
                    </button>
                {{/marketplace_type_filters}}
            </div>

            <div class="marketplace-plugin-grid" id="marketplace-plugin-grid">
                {{#marketplace_plugins}}
                    <article class="marketplace-plugin-item"
                             data-marketplace-card
                             data-marketplace-plugin-type="{{type}}"
                             data-search="{{name}} {{component}} {{type}} {{category}} {{description}}">
                        <div class="marketplace-plugin-header">
                            <div class="marketplace-plugin-icon">
                                {{#has_icon}}
                                    <img src="{{icon_url}}" alt="{{name}}" loading="lazy">
                                {{/has_icon}}
                                {{^has_icon}}
                                    <span>EK</span>
                                {{/has_icon}}
                            </div>
                            <div class="marketplace-plugin-title">
                                <h3>{{name}}</h3>
                                <code>{{component}}</code>
                            </div>
                        </div>

                        <p class="marketplace-plugin-description">{{description}}</p>

                        <div class="marketplace-plugin-meta">
                            <span>{{category_display}}</span>
                            {{#has_moodle}}
                                <span>{{{i18n.moodle_plugins.marketplace_moodle}}} {{moodle}}</span>
                            {{/has_moodle}}
                        </div>

                        <div class="marketplace-plugin-actions">
                            <a class="button secondary"
                               href="https://eduardokraus.com/marketplace-plugins/plugin/{{component}}"
                               target="_blank" rel="noopener">
                                {{{i18n.moodle_plugins.marketplace_page}}}
                            </a>
                            <a class="button secondary" href="{{repository_url}}" target="_blank" rel="noopener">
                                {{{i18n.moodle_plugins.marketplace_repository}}}
                            </a>
                            <form method="post" class="inline-form">
                                <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                                <input type="hidden" name="action" value="install_plugin">
                                <input type="hidden" name="git_url" value="{{repository_url}}">
                                <button type="submit" class="button" {{^can_install}}disabled{{/can_install}}>
                                    {{install_button_label}}
                                </button>
                            </form>
                        </div>
                    </article>
                {{/marketplace_plugins}}
            </div>
            <div class="alert warning compact-alert" id="marketplace-empty-filter" hidden>
                {{{i18n.moodle_plugins.marketplace_empty}}}
            </div>
        {{/has_marketplace}}
    </div>

    <div class="card full-card">
        <h2>{{{i18n.moodle_plugins.install_heading}}}</h2>
        <p class="card-subtitle">{{{i18n.moodle_plugins.install_intro}}}</p>
        <form method="post" class="form">
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <input type="hidden" name="action" value="install_plugin">
            <label>
                {{{i18n.moodle_plugins.repository_label}}}
                <input type="url" name="git_url" placeholder="{{{i18n.moodle_plugins.repository_placeholder}}}" required>
            </label>
            <div class="hero-actions">
                <button type="submit" class="button">{{{i18n.moodle_plugins.install_button}}}</button>
            </div>
        </form>
        <p class="card-subtitle">{{{i18n.moodle_plugins.install_permissions}}}</p>
    </div>
</div>


<style>
    .marketplace-card {
        overflow: hidden;
    }

    .marketplace-heading {
        align-items: flex-start;
        gap: 18px;
    }

    .marketplace-result-count {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        white-space: nowrap;
        font-size: .9rem;
        opacity: .8;
    }

    .marketplace-result-count strong {
        font-size: 1.25rem;
    }

    .marketplace-search {
        display: grid;
        gap: 7px;
        margin: 18px 0 20px;
        max-width: 560px;
        font-weight: 600;
    }

    .marketplace-type-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin: -4px 0 20px;
    }

    .marketplace-type-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 40px;
        padding: 7px 10px;
        border: 1px solid rgba(127, 127, 127, .24);
        border-radius: 11px;
        background: rgba(127, 127, 127, .05);
        color: inherit;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

    .marketplace-type-button:hover {
        border-color: currentColor;
        background: rgba(127, 127, 127, .11);
        transform: translateY(-1px);
    }

    .marketplace-type-button.is-active {
        border-color: currentColor;
        background: rgba(127, 127, 127, .16);
        box-shadow: inset 0 0 0 1px currentColor;
    }

    .marketplace-type-button svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .marketplace-type-button small {
        min-width: 24px;
        padding: 2px 6px;
        border-radius: 999px;
        background: rgba(127, 127, 127, .14);
        text-align: center;
        font-size: .72rem;
        font-weight: 800;
    }

    .marketplace-plugin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(285px, 1fr));
        gap: 16px;
    }

    .marketplace-plugin-item[hidden] {
        display: none !important;
    }

    .marketplace-plugin-item {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 14px;
        padding: 18px;
        border: 1px solid rgba(127, 127, 127, .24);
        border-radius: 16px;
        background: rgba(127, 127, 127, .04);
    }

    .marketplace-plugin-header {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .marketplace-plugin-icon {
        display: grid;
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        place-items: center;
        overflow: hidden;
        border: 1px solid rgba(127, 127, 127, .2);
        border-radius: 14px;
        background: rgba(127, 127, 127, .08);
        font-weight: 800;
    }

    .marketplace-plugin-icon img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 7px;
        box-sizing: border-box;
    }

    .marketplace-plugin-title {
        min-width: 0;
    }

    .marketplace-plugin-title h3 {
        margin: 0 0 5px;
        font-size: 1rem;
    }

    .marketplace-plugin-title code {
        display: block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .marketplace-plugin-description {
        margin: 0;
        line-height: 1.5;
        opacity: .86;
    }

    .marketplace-plugin-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: auto;
    }

    .marketplace-plugin-meta span {
        padding: 5px 9px;
        border-radius: 999px;
        background: rgba(127, 127, 127, .11);
        font-size: .78rem;
    }

    .marketplace-plugin-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .marketplace-plugin-actions .inline-form {
        margin: 0;
    }

    @media (max-width: 640px) {
        .marketplace-plugin-grid {
            grid-template-columns: 1fr;
        }

        .marketplace-plugin-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .marketplace-plugin-actions .button,
        .marketplace-plugin-actions .inline-form,
        .marketplace-plugin-actions .inline-form button {
            width: 100%;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".plugin-summary-row").forEach(function (row) {
            const toggle = function () {
                const details = document.getElementById(row.dataset.detailsId);
                if (!details) {
                    return;
                }
                const opening = details.hidden;
                details.hidden = !opening;
                row.setAttribute("aria-expanded", opening ? "true" : "false");
            };

            row.addEventListener("click", function (event) {
                if (event.target.closest("form, button, a, input")) {
                    return;
                }
                toggle();
            });
            row.addEventListener("keydown", function (event) {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    toggle();
                }
            });
        });

        const marketplaceSearch = document.getElementById("marketplace-search");
        const marketplaceCards = Array.from(document.querySelectorAll("[data-marketplace-card]"));
        const marketplaceTypeFilters = document.querySelector(".marketplace-type-filters");
        const marketplaceCount = document.getElementById("marketplace-visible-count");
        const marketplaceEmpty = document.getElementById("marketplace-empty-filter");
        let marketplaceSelectedType = "";

        if (marketplaceCards.length) {
            const filterMarketplace = function () {
                const query = marketplaceSearch ? marketplaceSearch.value.trim().toLocaleLowerCase() : "";
                let visible = 0;

                marketplaceCards.forEach(function (card) {
                    const haystack = (card.getAttribute("data-search") || "").toLocaleLowerCase();
                    const cardType = card.getAttribute("data-marketplace-plugin-type") || "";
                    const matchesQuery = query === "" || haystack.includes(query);
                    const matchesType = marketplaceSelectedType === "" || cardType === marketplaceSelectedType;
                    const show = matchesQuery && matchesType;

                    card.hidden = !show;
                    if (show) {
                        visible++;
                    }
                });

                if (marketplaceCount) {
                    marketplaceCount.textContent = String(visible);
                }
                if (marketplaceEmpty) {
                    marketplaceEmpty.hidden = visible !== 0;
                }
            };

            if (marketplaceSearch) {
                marketplaceSearch.addEventListener("input", filterMarketplace);
            }

            if (marketplaceTypeFilters) {
                marketplaceTypeFilters.addEventListener("click", function (event) {
                    const button = event.target.closest(".marketplace-type-button");
                    if (!button || !marketplaceTypeFilters.contains(button)) {
                        return;
                    }

                    event.preventDefault();
                    marketplaceSelectedType = button.getAttribute("data-marketplace-type") || "";

                    marketplaceTypeFilters.querySelectorAll(".marketplace-type-button").forEach(function (item) {
                        const active = item === button;
                        item.classList.toggle("is-active", active);
                        item.setAttribute("aria-pressed", active ? "true" : "false");
                    });

                    filterMarketplace();
                });
            }

            filterMarketplace();
        }
    });
</script>
