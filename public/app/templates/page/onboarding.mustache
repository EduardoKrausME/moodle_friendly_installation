{{#setup_completed}}
    <section class="card setup-complete">
        <span class="setup-complete-icon" aria-hidden="true">✓</span>
        <span class="setup-badge">{{{i18n.onboarding.completed_badge}}}</span>
        <h1>{{{i18n.onboarding.completed_heading}}}</h1>
        <p>{{{i18n.onboarding.completed_intro}}}</p>

        <dl class="setup-credentials">
            <div>
                <dt>{{{i18n.onboarding.next_login_username}}}</dt>
                <dd><code>{{next_login_username}}</code></dd>
            </div>
            <div>
                <dt>{{{i18n.onboarding.next_login_password}}}</dt>
                <dd><code>{{next_login_password}}</code></dd>
            </div>
        </dl>

        <div class="alert warning setup-alert">
            <strong>{{{i18n.onboarding.password_once_heading}}}</strong>
            <p>{{{i18n.onboarding.password_once_intro}}}</p>
        </div>

        <a class="button" href="{{{base_url}}}/login.php">{{{i18n.onboarding.go_to_login}}}</a>
    </section>
{{/setup_completed}}

{{#show_wizard}}
    <section class="page-title onboarding-hero">
        <div>
            <span class="setup-badge">{{{i18n.onboarding.one_click_badge}}}</span>
            <h1>{{{i18n.onboarding.heading}}}</h1>
            <p>{{{i18n.onboarding.intro}}}</p>
        </div>

        <ol class="setup-progress" aria-label="{{{i18n.onboarding.progress_label}}}">
            <li class="setup-progress-step{{#step_one_active}} is-active{{/step_one_active}}{{#step_one_complete}} is-complete{{/step_one_complete}}">
                <span>1</span>
                <strong>{{{i18n.onboarding.address_step}}}</strong>
            </li>
            <li class="setup-progress-step{{#step_two_active}} is-active{{/step_two_active}}{{#step_two_complete}} is-complete{{/step_two_complete}}">
                <span>2</span>
                <strong>{{{i18n.onboarding.update_step}}}</strong>
            </li>
            <li class="setup-progress-step{{#step_three_active}} is-active{{/step_three_active}}">
                <span>3</span>
                <strong>{{{i18n.onboarding.security_step}}}</strong>
            </li>
        </ol>
    </section>

    {{#has_errors}}
        <div class="alert danger">
            <strong>{{{i18n.onboarding.check_fields}}}</strong>
            <ul>
                {{#errors}}
                    <li>{{message}}</li>
                {{/errors}}
            </ul>
        </div>
    {{/has_errors}}

    {{#show_step_one}}
        <form method="post" class="form" id="onboarding-domain-form">
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <input type="hidden" name="action" value="save_url">
            <input type="hidden" name="panel_domain_job_id" id="panel-domain-job-id" value="">

            <div class="card onboarding-step">
                <div class="setup-section-heading">
                    <span>1</span>
                    <div>
                        <h2>{{{i18n.onboarding.address_heading}}}</h2>
                        <p>{{{i18n.onboarding.address_intro}}}</p>
                    </div>
                </div>

                <label>
                    {{{i18n.onboarding.base_url}}}
                    <input type="text" name="base_url" value="{{base_url}}"
                           placeholder="painel.seudominio.com.br"
                           autocomplete="url" required autofocus>
                    <small>{{{i18n.onboarding.base_url_help}}}</small>
                </label>

                <div id="panel-domain-status" class="panel-domain-checklist" hidden aria-live="polite">
                    <strong class="panel-domain-checklist-title">{{panel_domain_checklist_title}}</strong>
                    <ol class="panel-domain-checklist-items">
                        <li data-panel-domain-step="request_received">
                            <span class="panel-domain-check-icon" aria-hidden="true">○</span>
                            <span class="panel-domain-check-content"><strong>{{panel_domain_check_request_received}}</strong><small></small></span>
                        </li>
                        <li data-panel-domain-step="public_ip_detected">
                            <span class="panel-domain-check-icon" aria-hidden="true">○</span>
                            <span class="panel-domain-check-content"><strong>{{panel_domain_check_public_ip}}</strong><small></small></span>
                        </li>
                        <li data-panel-domain-step="dns_validated">
                            <span class="panel-domain-check-icon" aria-hidden="true">○</span>
                            <span class="panel-domain-check-content"><strong>{{panel_domain_check_dns}}</strong><small></small></span>
                        </li>
                        <li data-panel-domain-step="configuring_webserver">
                            <span class="panel-domain-check-icon" aria-hidden="true">○</span>
                            <span class="panel-domain-check-content"><strong>{{panel_domain_check_webserver_config}}</strong><small></small></span>
                        </li>
                        <li data-panel-domain-step="testing_webserver">
                            <span class="panel-domain-check-icon" aria-hidden="true">○</span>
                            <span class="panel-domain-check-content"><strong>{{panel_domain_check_webserver_test}}</strong><small></small></span>
                        </li>
                        <li data-panel-domain-step="issuing_certificate">
                            <span class="panel-domain-check-icon" aria-hidden="true">○</span>
                            <span class="panel-domain-check-content"><strong>{{panel_domain_check_certificate}}</strong><small></small></span>
                        </li>
                        <li data-panel-domain-step="activating_domain">
                            <span class="panel-domain-check-icon" aria-hidden="true">○</span>
                            <span class="panel-domain-check-content"><strong>{{panel_domain_check_activation}}</strong><small></small></span>
                        </li>
                    </ol>
                </div>

                <div class="setup-step-actions is-next">
                    <button type="submit">{{{i18n.onboarding.next}}}</button>
                </div>
            </div>

            <div class="card onboarding-step">
                <div class="setup-guide-inline">
                    <div class="setup-section-heading">
                        <span aria-hidden="true">🔒</span>
                        <div>
                            <h2>{{{i18n.onboarding.https_heading}}}</h2>
                            <p>{{panel_domain_intro}}</p>
                        </div>
                    </div>

                    {{#is_ip_url}}
                        <div class="alert warning setup-alert">
                            <strong>{{{i18n.onboarding.ip_detected_heading}}}</strong>
                            <p>{{{i18n.onboarding.ip_detected_intro}}}</p>
                        </div>
                    {{/is_ip_url}}

                    <ol class="setup-steps">
                        <li>
                            <strong>{{{i18n.onboarding.dns_step_heading}}}</strong>
                            <p>{{{i18n.onboarding.dns_step_intro}}}</p>
                            <dl class="setup-dns-grid">
                                <div>
                                    <dt>{{{i18n.onboarding.dns_type}}}</dt>
                                    <dd>A</dd>
                                </div>
                                <div>
                                    <dt>{{{i18n.onboarding.dns_name}}}</dt>
                                    <dd><code>{{dns_domain}}</code></dd>
                                </div>
                                <div>
                                    <dt>{{{i18n.onboarding.dns_destination}}}</dt>
                                    <dd>
                                        {{#has_public_ip}}<code>{{public_ip}}</code>{{/has_public_ip}}
                                        {{^has_public_ip}}{{{i18n.onboarding.public_ip_unavailable}}}{{/has_public_ip}}
                                    </dd>
                                </div>
                            </dl>
                        </li>
                        <li>
                            <strong>CRON root</strong>
                            <p>{{panel_domain_intro}}</p>
                        </li>
                        <li>
                            <strong>{{{i18n.onboarding.https_heading}}}</strong>
                            <p>{{panel_domain_ip_note}}</p>
                        </li>
                    </ol>
                </div>
            </div>
        </form>
    {{/show_step_one}}

    {{#show_step_two}}
        <form method="post" class="form">
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <input type="hidden" name="action" value="continue_after_update_check">

            <div class="card onboarding-step">
                <div class="setup-section-heading">
                    <span>2</span>
                    <div>
                        <h2>{{{i18n.onboarding.update_heading}}}</h2>
                        <p>{{{i18n.onboarding.update_intro}}}</p>
                    </div>
                </div>

                <dl class="setup-credentials setup-update-versions">
                    <div>
                        <dt>{{{i18n.onboarding.installed_version}}}</dt>
                        <dd><code>{{installed_version}}</code></dd>
                    </div>
                    {{#has_latest_version}}
                        <div>
                            <dt>{{{i18n.onboarding.latest_version}}}</dt>
                            <dd><code>{{latest_version}}</code></dd>
                        </div>
                    {{/has_latest_version}}
                </dl>

                {{#update_is_current}}
                    <div class="alert ok setup-alert">
                        <strong>{{{i18n.onboarding.update_current_heading}}}</strong>
                        <p>{{{i18n.onboarding.update_current_intro}}}</p>
                    </div>
                {{/update_is_current}}

                {{#update_available}}
                    <div class="alert warning setup-alert">
                        <strong>{{{i18n.onboarding.update_available_heading}}}</strong>
                        <p>{{{i18n.onboarding.update_available_intro}}}</p>
                        {{#has_latest_release_url}}
                            <p><a href="{{latest_release_url}}" target="_blank" rel="noopener">{{{i18n.onboarding.open_release}}}</a></p>
                        {{/has_latest_release_url}}
                    </div>
                {{/update_available}}

                {{#update_check_failed}}
                    <div class="alert danger setup-alert">
                        <strong>{{{i18n.onboarding.update_error_heading}}}</strong>
                        <p>{{{i18n.onboarding.update_error_intro}}}</p>
                        <p><code>{{update_check_error}}</code></p>
                    </div>
                {{/update_check_failed}}

                <div class="setup-step-actions">
                    <a class="button secondary" href="/onboarding.php?step=1">{{{i18n.onboarding.back}}}</a>
                    <div class="setup-step-action-group">
                        <a class="button secondary" href="/onboarding.php?step=2">{{{i18n.onboarding.check_again}}}</a>
                        <button type="submit">{{{i18n.onboarding.continue_setup}}}</button>
                    </div>
                </div>
            </div>
        </form>
    {{/show_step_two}}

    {{#show_step_three}}
        <form method="post" class="form">
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <input type="hidden" name="action" value="finish">

            <div class="card onboarding-step">
                <div class="setup-section-heading">
                    <span>3</span>
                    <div>
                        <h2>{{{i18n.onboarding.security_heading}}}</h2>
                        <p>{{{i18n.onboarding.security_intro}}}</p>
                    </div>
                </div>

                <label>
                    {{{i18n.onboarding.next_login_username}}}
                    <input type="text" value="admin" readonly>
                    <small>{{{i18n.onboarding.username_help}}}</small>
                </label>

                <label>
                    {{{i18n.onboarding.new_password}}}
                    <input type="text" name="password" autocomplete="new-password" minlength="8" required autofocus>
                    <small>{{{i18n.onboarding.password_help}}}</small>
                </label>

                <div class="setup-step-actions">
                    <a class="button secondary" href="/onboarding.php?step=2">{{{i18n.onboarding.back}}}</a>
                    <button type="submit">{{{i18n.onboarding.finish}}}</button>
                </div>
            </div>
        </form>
    {{/show_step_three}}
{{/show_wizard}}

<style>
.panel-domain-checklist {
    margin: .85rem 0 1rem;
    padding: 1rem;
    border: 1px solid #d9dee7;
    border-radius: .65rem;
    background: #fff;
}
.panel-domain-checklist-title {
    display: block;
    margin-bottom: .8rem;
}
.panel-domain-checklist-items {
    list-style: none;
    margin: 0;
    padding: 0;
}
.panel-domain-checklist-items li {
    display: flex;
    align-items: flex-start;
    gap: .65rem;
    padding: .45rem 0;
    opacity: .62;
}
.panel-domain-check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 1.55rem;
    width: 1.55rem;
    height: 1.55rem;
    border: 1px solid #aab2c0;
    border-radius: 50%;
    line-height: 1;
    font-weight: 700;
}
.panel-domain-check-content {
    display: flex;
    flex-direction: column;
    gap: .1rem;
    min-width: 0;
}
.panel-domain-check-content small {
    display: block;
    line-height: 1.35;
}
.panel-domain-check-content small:empty {
    display: none;
}
.panel-domain-checklist-items li.is-active,
.panel-domain-checklist-items li.is-complete,
.panel-domain-checklist-items li.is-failed {
    opacity: 1;
}
.panel-domain-checklist-items li.is-active .panel-domain-check-icon {
    border-color: #805ad5;
}
.panel-domain-checklist-items li.is-complete .panel-domain-check-icon {
    border-color: #198754;
    background: #198754;
    color: #fff;
}
.panel-domain-checklist-items li.is-failed .panel-domain-check-icon {
    border-color: #dc3545;
    background: #dc3545;
    color: #fff;
}
</style>

<script>
(function () {
    "use strict";

    const form = document.getElementById("onboarding-domain-form");
    if (!form) {
        return;
    }

    const input = form.querySelector('[name="base_url"]');
    const jobInput = document.getElementById("panel-domain-job-id");
    const statusBox = document.getElementById("panel-domain-status");
    const statusItems = Array.from(statusBox.querySelectorAll("[data-panel-domain-step]"));
    const submitButton = form.querySelector('button[type="submit"]');
    let processing = false;
    let lastJob = null;

    const inputLabel = input ? input.closest("label") : null;
    if (inputLabel && statusBox) {
        inputLabel.insertAdjacentElement("afterend", statusBox);
    }

    function withScheme(value) {
        value = String(value || "").trim();
        if (/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) {
            return value;
        }
        return "https://" + value;
    }

    function parseUrl(value) {
        try {
            return new URL(withScheme(value));
        } catch (e) {
            return null;
        }
    }

    function isIp(host) {
        host = String(host || "").replace(/^\[|\]$/g, "");
        if (host.indexOf(":") !== -1) {
            return true;
        }
        const parts = host.split(".");
        return parts.length === 4 && parts.every(function (part) {
            return /^\d{1,3}$/.test(part) && Number(part) >= 0 && Number(part) <= 255;
        });
    }

    function showStatus(job, fallbackMessage) {
        job = job || {};
        const status = job.status || "failed";
        const completed = Array.isArray(job.completed_steps) ? job.completed_steps : [];
        const messages = job.step_messages && typeof job.step_messages === "object" ? job.step_messages : {};
        let currentStep = status === "failed" ? (job.failed_step || "") : (job.step || "");
        if ((currentStep === "pending" || currentStep === "waiting_dns") && status !== "failed") {
            currentStep = "dns_validated";
        }
        if (status === "failed" && !currentStep) {
            currentStep = "request_received";
        }

        statusBox.hidden = false;
        statusItems.forEach(function (item) {
            const step = item.dataset.panelDomainStep;
            const icon = item.querySelector(".panel-domain-check-icon");
            const detail = item.querySelector("small");
            const isComplete = completed.indexOf(step) !== -1 || status === "done";
            const isFailed = status === "failed" && currentStep === step && !isComplete;
            const isActive = !isComplete && !isFailed && currentStep === step;

            item.classList.toggle("is-complete", isComplete);
            item.classList.toggle("is-failed", isFailed);
            item.classList.toggle("is-active", isActive);
            icon.textContent = isComplete ? "✓" : (isFailed ? "✕" : (isActive ? "…" : "○"));

            let text = messages[step] || "";
            if ((isActive || isFailed) && job.message) {
                text = job.message;
            }
            if (isFailed && fallbackMessage) {
                text = fallbackMessage;
            }
            detail.textContent = text;
        });
    }
    async function api(data) {
        data.csrf_token = form.querySelector('[name="csrf_token"]').value;
        const response = await fetch("/ajax/panel-domain.php", {
            method: "POST",
            headers: {"Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"},
            body: new URLSearchParams(data).toString(),
            credentials: "same-origin"
        });
        const payload = await response.json();
        if (!response.ok || !payload.success) {
            throw new Error(payload.message || "Domain processing failed.");
        }
        return payload.job;
    }

    async function waitForJob(job) {
        while (true) {
            lastJob = job;
            showStatus(job, "");
            if (job.status === "done" || job.status === "failed") {
                return job;
            }
            await new Promise(function (resolve) { window.setTimeout(resolve, 2000); });
            job = await api({action: "status", id: job.id});
        }
    }

    form.addEventListener("submit", async function (event) {
        if (processing) {
            event.preventDefault();
            return;
        }

        const requested = parseUrl(input.value);
        if (!requested || isIp(requested.hostname)) {
            return;
        }

        event.preventDefault();
        processing = true;
        submitButton.disabled = true;
        input.readOnly = true;

        try {
            let job = await api({
                action: "request",
                source: "onboarding",
                base_url: input.value
            });
            lastJob = job;
            job = await waitForJob(job);
            if (job.status !== "done") {
                throw new Error(job.message || job.error || "Domain processing failed.");
            }

            lastJob = job;
            jobInput.value = job.id;
            input.value = job.result_url || job.requested_url;
            showStatus(job, "");
            HTMLFormElement.prototype.submit.call(form);
        } catch (error) {
            processing = false;
            submitButton.disabled = false;
            input.readOnly = false;
            if (lastJob) {
                lastJob.status = "failed";
                lastJob.message = error.message;
                showStatus(lastJob, error.message);
            } else {
                showStatus({status: "failed", failed_step: "request_received", message: error.message}, error.message);
            }
        }
    });
})();
</script>
