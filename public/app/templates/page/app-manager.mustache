<section class="page-title">
    <div>
        <h1>{{{i18n.app_manager.heading_prefix}}} {{domain}}</h1>
        <h3 style="margin-top:0;">{{{i18n.app_manager.version}}}: <strong>{{app_version}}</strong></h3>
        <p>{{{i18n.app_manager.intro}}}</p>
    </div>
    <a class="button secondary" href="{{back_url}}">{{{i18n.actions.back_to_details}}}</a>
</section>

<div class="card full-card">
    <h2>{{{i18n.app_manager.moodle_config_heading}}}</h2>

    {{#moodle_config_test_valid}}
        <div class="alert ok compact-alert">{{{i18n.app_manager.moodle_config_ok}}}</div>
        <a class="button" href="{{app_preview_url}}" target="_blank">{{{i18n.actions.preview_app}}}</a>
    {{/moodle_config_test_valid}}

    {{#has_moodle_config_test_error}}
        <div class="alert danger compact-alert">
            {{moodle_config_test.error}}
            {{#moodle_config_test.has_install_url}}
                <div class="hero-actions" style="margin-top: 12px;">
                    <form method="post" action="{{plugin_install_action_url}}" class="inline-form">
                        <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                        <input type="hidden" name="action" value="install_plugin">
                        <input type="hidden" name="git_url" value="{{plugin_install_repository_url}}">
                        <button type="submit" class="button">{{{i18n.app_manager.moodle_config_install_plugin}}}</button>
                    </form>
                </div>
            {{/moodle_config_test.has_install_url}}
        </div>
    {{/has_moodle_config_test_error}}

    {{#has_moodle_config_test_warnings}}
        <div class="alert warning compact-alert">
            <strong>{{{i18n.app_manager.moodle_config_warning}}}</strong>
            <ul>
                {{#moodle_config_test.warnings}}
                    <li>
                        <div><code>{{key}}</code> {{description}}</div>
                        <div style="color: #d04646;"><strong>{{{i18n.status.error}}}:</strong> {{message}}</div>
                        {{#has_edit_url}}
                            <a href="{{edit_url}}" target="_blank"
                               rel="noopener">{{{i18n.app_manager.moodle_config_edit_link}}}</a>
                        {{/has_edit_url}}
                    </li>
                {{/moodle_config_test.warnings}}
            </ul>
        </div>
    {{/has_moodle_config_test_warnings}}
</div>

<div class="details-grid">
    <form method="post" enctype="multipart/form-data" class="card form full-card">
        <input type="hidden" name="csrf_token" value="{{csrf_token}}">

        <h2>{{{i18n.app_manager.config_heading}}}</h2>

        {{#has_flash}}
            <div class="alert ok">{{flash}}</div>
        {{/has_flash}}

        {{#has_errors}}
            <div class="alert danger">{{{i18n.app_manager.check_fields}}}</div>
        {{/has_errors}}

        {{#errors.general}}
            <div class="alert danger">{{.}}</div>
        {{/errors.general}}

        {{#errors.build}}
            <div class="alert danger">{{.}}</div>
        {{/errors.build}}

        {{#show_keystore_password}}
            {{#errors.keystore_password}}
                <small class="alert alert-danger">{{.}}</small>
            {{/errors.keystore_password}}
        {{/show_keystore_password}}
        {{#errors.package_uid}}
            <small class="alert alert-danger">{{.}}</small>
        {{/errors.package_uid}}
        {{#errors.package_name}}
            <small class="alert alert-danger">{{.}}</small>
        {{/errors.package_name}}
        {{#errors.icon}}
            <small class="alert alert-danger">{{.}}</small>
        {{/errors.icon}}

        {{#show_keystore_password}}
            <label class="alert danger">
                {{{i18n.app_manager.keystore_password}}}
                <input type="text" name="keystore_password" autocomplete="new-password" minlength="6" required>
                <small>{{{i18n.app_manager.keystore_help}}}</small>
                {{#errors.keystore_password}}
                    <small class="alert alert-danger">{{.}}</small>{{/errors.keystore_password}}
            </label>
        {{/show_keystore_password}}

        <label>
            Package UID
            {{#values.package_uid_locked}}
                <span style="font-weight:400;">{{values.package_uid}}</span>
                {{#values.package_uid_locked}}
                    <small class="alert alert-danger">{{{i18n.app_manager.package_uid_locked}}}</small>
                {{/values.package_uid_locked}}
            {{/values.package_uid_locked}}
            {{^values.package_uid_locked}}
                <input type="text"
                       name="package_uid"
                       placeholder="{{domain}}"
                       value="{{values.package_uid}}">
            {{/values.package_uid_locked}}
            {{#errors.package_uid}}
                <small class="alert alert-danger">{{.}}</small>
            {{/errors.package_uid}}
        </label>

        <label>
            {{{i18n.app_manager.package_name}}}
            <input type="text" name="package_name" value="{{values.package_name}}" required>
            {{#errors.package_name}}<small class="alert alert-danger">{{.}}</small>{{/errors.package_name}}
        </label>

        {{#has_theme_branding}}
            <div class="alert ok compact-alert">
                <strong>{{{i18n.app_manager.theme_connected}}}</strong>
                <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;">
                    <span><span style="display:inline-block;width:18px;height:18px;vertical-align:middle;border:1px solid #999;background:{{theme_brandcolor}}"></span>
                        {{{i18n.app_manager.theme_brandcolor}}}: <code>{{theme_brandcolor}}</code></span>
                    <span><span style="display:inline-block;width:18px;height:18px;vertical-align:middle;border:1px solid #999;background:{{theme_accentcolor}}"></span>
                        {{{i18n.app_manager.theme_accentcolor}}}: <code>{{theme_accentcolor}}</code></span>
                    <span><span style="display:inline-block;width:18px;height:18px;vertical-align:middle;border:1px solid #999;background:{{theme_canvascolor}}"></span>
                        {{{i18n.app_manager.theme_canvascolor}}}: <code>{{theme_canvascolor}}</code></span>
                    <span><span style="display:inline-block;width:18px;height:18px;vertical-align:middle;border:1px solid #999;background:{{theme_textcolor}}"></span>
                        {{{i18n.app_manager.theme_textcolor}}}: <code>{{theme_textcolor}}</code></span>
                </div>
                {{#has_theme_logo}}
                    <div style="margin-top:12px;">
                        <strong>{{{i18n.app_manager.theme_logo}}}</strong>
                        <img src="{{theme_logo_url}}" alt="" loading="lazy"
                             style="display:block;max-width:220px;max-height:90px;object-fit:contain;margin-top:8px;">
                    </div>
                {{/has_theme_logo}}
                {{^has_theme_logo}}
                    <small>{{{i18n.app_manager.theme_logo_missing}}}</small>
                {{/has_theme_logo}}
            </div>
        {{/has_theme_branding}}
        {{^has_theme_branding}}
            <div class="alert warning compact-alert">{{{i18n.app_manager.theme_unavailable}}}</div>
        {{/has_theme_branding}}

        <label>
            {{{i18n.app_manager.icon}}}
            <input type="file" name="icon" accept="image/png">
            <small>{{{i18n.app_manager.icon_auto}}}</small>
            {{#has_theme_logo}}
                {{#values.has_icon}}
                    {{^values.icon_from_theme}}
                        <label style="display:flex;gap:8px;align-items:center;">
                            <input type="checkbox" name="use_theme_logo" value="1">
                            {{{i18n.app_manager.use_theme_logo}}}
                        </label>
                    {{/values.icon_from_theme}}
                {{/values.has_icon}}
            {{/has_theme_logo}}
            {{#values.has_icon}}
                <small>{{{i18n.app_manager.current_icon}}}
                    <code>{{values.icon_path}}</code>. {{{i18n.app_manager.replace_icon_help}}}</small>
            {{/values.has_icon}}
            {{^values.has_icon}}
                <small>{{{i18n.app_manager.icon_required_help}}}</small>
            {{/values.has_icon}}
            {{#errors.icon}}<small class="alert alert-danger">{{.}}</small>{{/errors.icon}}
        </label>

        <label>
            {{{i18n.app_manager.app_scss}}}
            <textarea name="app_scss" rows="12" spellcheck="false"
                      placeholder=":root { --primary-color: #58CC02; }">{{values.app_scss}}</textarea>
            <small>{{{i18n.app_manager.app_scss_help}}}</small>
            {{#errors.app_scss}}<small class="alert alert-danger">{{.}}</small>{{/errors.app_scss}}
        </label>

        {{^build_ready}}
            {{#has_build_missing}}
                <div class="alert warning compact-alert">
                    <strong>{{{i18n.app_manager.missing_before_build}}}</strong>
                    <ul>
                        {{#build_missing}}
                            <li>{{message}}</li>
                        {{/build_missing}}
                    </ul>
                </div>
            {{/has_build_missing}}
        {{/build_ready}}

        <div class="form-actions split-actions">
            <button type="submit" name="action" value="save_app"
                    class="button secondary">{{{i18n.actions.save_configuration}}}</button>
            {{#build_ready}}
                <button type="submit" name="action" value="build_app" class="button">{{{i18n.actions.build_app}}}</button>
            {{/build_ready}}
        </div>
    </form>

    <div class="card">
        <h2>{{{i18n.app_manager.generated_files}}}</h2>
        <p class="card-subtitle">{{{i18n.app_manager.generated_files_intro}}}</p>
        {{^has_build_files}}
            <div class="alert warning compact-alert">{{{i18n.app_manager.no_build_files}}}</div>
        {{/has_build_files}}
        {{#has_build_files}}
            <div class="details-table">
                {{#build_files}}
                    <h3 style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0;">
                        <span>{{label}}</span>
                        <a class="button secondary" href="{{download_url}}">{{{i18n.actions.download}}} {{label}}</a>
                    </h3>
                    <small><code>{{filename}}</code> / {{size}} / {{created_at}}</small>
                {{/build_files}}
            </div>
        {{/has_build_files}}
    </div>

    <div class="card">
        <h2>{{{i18n.app_manager.latest_job}}}</h2>
        {{^has_latest_job}}
            <p>{{{i18n.app_manager.no_latest_job}}}</p>
        {{/has_latest_job}}
        {{#has_latest_job}}
            <div><strong>{{{i18n.jobs.job}}}</strong>: <code>{{latest_job.id}}</code></div>
            <div><strong>{{{i18n.jobs.status}}}</strong>: {{{latest_job.status_badge}}}</div>
            <div><strong>{{{i18n.jobs.created}}}</strong>: {{latest_job.created_at}}</div>
            {{#latest_job.has_error}}
                <div class="alert danger compact-alert">{{latest_job.error}}</div>
            {{/latest_job.has_error}}
            <p><a href="/jobs.php" target="_blank">{{{i18n.app_manager.view_full_log}}}</a></p>
        {{/has_latest_job}}
    </div>
</div>

{{#should_refresh}}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            setTimeout(function () {
                window.location.reload();
            }, 30000);
        });
    </script>
{{/should_refresh}}
