        <icon height="1024" src="res/kraus/ios/icon-1024.png" width="1024" />
        <icon height="172" src="res/kraus/ios/icon-98@2x.png" width="172" />
        <icon height="196" src="res/kraus/ios/icon-86@2x.png" width="196" />
